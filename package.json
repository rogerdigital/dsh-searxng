{
  "name": "dsh-searxng",
  "version": "0.1.2",
  "description": "SearXNG-backed search provider for the DeepSeek Harness web capability seam (ctx.web)",
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "bin": {
    "dsh-searxng": "./lib/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "seams": [
      "web"
    ]
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "pnpm pack --pack-destination ./node_modules/.cache/pack",
    "pack:test": "node scripts/check-packed-cli.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm pack:check && pnpm pack:test",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "searxng",
    "search",
    "metasearch",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerdigital/dsh-searxng.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.0.1-rc.3 <0.2.0",
    "@deepseek-ai/dsh-web": ">=0.1.0-rc.6 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@deepseek-ai/dsh-web": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "cross-spawn": "^7.0.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-launch-environment": "0.0.1-rc.3",
    "@deepseek-ai/dsh-web": "0.1.0-rc.6",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "tsdown": "0.21.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
